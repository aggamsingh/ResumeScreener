# ══════════════════════════════════════════════════════════════
#  Resume Screener — Environment Configuration
#
#  HOW TO USE:
#    1. Copy this file:   cp .env.example .env
#    2. Fill in your values below
#    3. Never commit .env to git (it contains secrets)
# ══════════════════════════════════════════════════════════════


# ── LLM Reranker ───────────────────────────────────────────────
#
# Which AI provider to use for reranking candidates.
# Options: "groq" (recommended — faster, free tier) or "gemini"
LLM_PROVIDER=groq

# Groq API Key
# Sign up free at: https://console.groq.com
# Free tier: 30 req/min, 14,400 req/day — plenty for HR use
GROQ_API_KEY=

# Groq model to use (default is fast + accurate, do not change unless needed)
GROQ_MODEL=llama-3.1-8b-instant

# Gemini API Key — only fill this if you set LLM_PROVIDER=gemini above
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (only if LLM_PROVIDER=gemini).
# gemini-1.5-flash is retired and now 404s, which the reranker swallowed as a
# generic "LLM failed" and silently fell back to raw vector ordering.
GEMINI_MODEL=gemini-2.5-flash


# ── API Security ───────────────────────────────────────────────
#
# A secret key your ERP system must send in the X-API-Key header.
#
# This MUST be non-empty — the service refuses to start otherwise (API_KEY has
# min_length=1), so shipping this blank meant `cp .env.example .env` produced a
# service that crashed on boot with a pydantic ValidationError.
#
# The value below is also the default the TalentMatch frontend sends, so the two
# work together out of the box. Anything else and every /api/v1/* call gets 401
# until you paste the matching key into Settings -> Python AI Microservice.
#
# BEFORE DEPLOYING: replace it. Generate one with:  openssl rand -hex 32
API_KEY=talentmatch_microservice_api_key_12345


# ── CV Storage ─────────────────────────────────────────────────
#
# Full path to the folder containing your CV/resume files.
# The indexer will scan this folder recursively for .pdf and .docx files.
#
# Examples:
#   Windows:  CV_FOLDER_PATH=C:/HR/Resumes
#   Linux:    CV_FOLDER_PATH=/mnt/shared/resumes
#   Default:  CV_FOLDER_PATH=./cvs   (puts CVs in the project's cvs/ folder)
CV_FOLDER_PATH=./cvs


# ── Qdrant Vector Database ─────────────────────────────────────
#
# Leave these as default unless you changed the docker-compose.yml ports.
# "localhost" is correct for running the API and indexer directly on your machine
# (docker compose up -d qdrant). docker-compose.yml overrides this to the "qdrant"
# service name for the containerised services, so it works in both setups.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=resumes


# ── Screening Defaults ─────────────────────────────────────────
#
# Default number of candidates to return per screening request.
# Can be overridden per-request via the "top_k" field in the API body.
DEFAULT_TOP_K=10

# How many candidates to fetch from the vector DB before LLM reranking.
# Higher = more accurate but slightly slower. Recommended range: 20–50.
RETRIEVAL_TOP_N=30

# Embedding model — do not change unless you know what you're doing.
# Changing this requires re-indexing all CVs from scratch.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OCR for scanned / image-only PDFs.
# When true (default), the indexer uses Tesseract to extract text from
# PDFs that have no text layer (e.g. scanned paper CVs, photo PDFs).
# Set to false if all your CVs are digital/text-based — slightly faster indexing.
# Requires: tesseract-ocr and poppler-utils (pre-installed in Docker image).
ENABLE_OCR=true


# ── Server ─────────────────────────────────────────────────────
#
# Port the API will be accessible on. http://your-server-ip:8000
API_PORT=8000

# Log level: DEBUG (verbose) | INFO (normal) | WARNING | ERROR
LOG_LEVEL=INFO

# ── CORS ───────────────────────────────────────────────────────
#
# Which origins (domains) can call this API from a browser.
# Use * to allow all, or comma-separate specific domains:
#   ALLOWED_ORIGINS=https://erp.yourcompany.com,https://hr.yourcompany.com
# Default allows the Vite dev server. Lock this down to your real domains
# before deploying — it is now actually enforced.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173


# ── SharePoint Sync (optional) ───────────────────────────────────────────────
#
# Used by POST /api/v1/sync to pull resumes out of SharePoint into CV_FOLDER_PATH.
# Leave blank to disable — you can also pass all of these per-request in the
# body of /api/v1/sync, which overrides whatever is set here.
#
# Azure AD app registration (Azure Portal → App registrations → your app):
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# The app needs the APPLICATION permission Sites.Read.All (or Sites.Selected
# scoped to this site), with admin consent granted. Delegated permissions do
# not work here — this is a client-credentials flow with no signed-in user.

# The SharePoint site to read from. Strongly recommended: without it the sync
# guesses by searching the whole tenant for a site named "recruitment" and
# falls back to whatever site happens to come back first.
#   SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/Recruitment
SHAREPOINT_SITE_URL=

# Folder to scan, RELATIVE TO THE DOCUMENT LIBRARY ROOT — not the site URL.
# For .../sites/Recruitment/Shared Documents/CV Database/Master CV the value is
# "CV Database/Master CV". Leave blank to scan the whole library recursively.
SHAREPOINT_FOLDER_PATH=
